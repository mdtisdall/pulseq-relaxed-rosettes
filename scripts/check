#!/usr/bin/env bash
# All the checks that CI runs, in one command. Run it in the devShell:
#
#   nix develop --command scripts/check
set -euo pipefail
cd "$(dirname "$0")/.."

uv sync --frozen --all-extras
uv run ruff check .
uv run ruff format --check .
uv run mypy src tests
uv run pytest -q
uv run python scripts/check_links.py
