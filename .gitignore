# direnv, and this project's GitHub token (dev-workflow)
.direnv/
.envrc.local
.envrc.local.*
# One git worktree for each task (dev-workflow start-task)
.worktrees/
# Siemens gradient system files: confidential, never commit (data/README.md)
data/*.asc
# Local results, designs and sequences (data/<topic>-<date>/); data/README.md is not ignored
data/*
!data/README.md
